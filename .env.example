# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Admin user ID that receives ban-approval DMs (Approve / Deny buttons)
ADMIN_USER_ID=1286240448775720962

# --- Mini World API endpoints ---
# Single-fire ban:  ?bandev=<UID>
BANDEV_API_URL=https://bandev.daxterrantares.workers.dev

# Cloudflare loop worker (KV + Cron) for duration bans: ?uid=<UID>&bantime=<seconds>
# Leave EMPTY to fall back to a local scheduler (loses schedule on restart).
BANDEV_LOOP_API_URL=

# Player name lookup:  ?uid=<UID>
BASEINFO_V1_API_URL=https://baseinfov1.daxterrantares.workers.dev
