# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Owner who gets a DM notification (with details) on every !bandev use
OWNER_ID=1286240448775720962

# --- Mini World API endpoints ---
# Single-fire ban backend — used for EVERY ban call (first fire + each 3-min repeat).
# Pattern: ?bandev=<UID>
BANDEV_API_URL=https://bandev.daxterrantares.workers.dev

# Player name lookup:  ?uid=<UID>
BASEINFO_V1_API_URL=https://baseinfov1.daxterrantares.workers.dev

# !checkinfo — full account info. Pattern: /getinfo=<UID>
GETINFO_API_URL=http://getinfoapi.onrender.com/getinfo=

# Mapbox token — enables the static map image in !checkinfo.
# Get one free at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
